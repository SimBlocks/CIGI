def StopCamera3SpinAccel()
{
  logMessage("Camera stop 3, Spin accel");
    
  var velocityControl = EntityVelocityControl();
  velocityControl.EntityID = 2;
  velocityControl.XLinearVelocity = 0;
  velocityControl.YLinearVelocity = 0;
  velocityControl.ZLinearVelocity = 0;
  velocityControl.RollAngularVelocity = 0;
  velocityControl.PitchAngularVelocity = 0;
  velocityControl.YawAngularVelocity = 0;
  velocityControl.CoordinateSystem = "World/Parent";
  sendEntityVelocityControl(velocityControl);
  
  
  var entityPositionChild = ChildEntityPosition();
  entityPositionChild.EntityID = 2;
  entityPositionChild.AttachState = "Attach";
  entityPositionChild.Yaw = 0;
  entityPositionChild.Pitch = 0;
  entityPositionChild.Roll = 0;
  entityPositionChild.ParentID = 10;
  entityPositionChild.XOffset = 0;
  entityPositionChild.YOffset = 0;
  entityPositionChild.ZOffset = 0;
  sendChildEntityPosition(entityPositionChild);
  
  symSpinAcc = -10.0;
}

// -----------------
// SUPPORT FUNCTIONS
// -----------------

def addVertex(vertices,u,v)
{
  var vertex = VertexUV();
  vertex.U = u;
  vertex.V = v;
  vertices.push_back(vertex);
}




